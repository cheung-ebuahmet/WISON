# Binary "cold files" — ignored by git
# These are the source of truth on disk but git only tracks
# their text-format derivatives (.md, .csv, .txt)
*.pdf
*.docx
*.doc
*.xlsx
*.xls
*.zip
*.rar
*.7z
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff
*.tif

# OS junk
Thumbs.db
.DS_Store
desktop.ini

# Temp files
~$*
*.tmp
